{
  "name": "@gouch/to-title-case",
  "description": "Convert strings to title case with some intelligence.",
  "version": "3.0.0",
  "author": "David Gouch",
  "devDependencies": {
    "prettier": "^3.9.0",
    "qunit": "^3.0.0",
    "typescript": "^7.0.0"
  },
  "keywords": [
    "prose",
    "writing",
    "styleguide",
    "standards"
  ],
  "license": "MIT",
  "repository": "github:gouch/to-title-case",
  "type": "module",
  "exports": {
    "import": "to-title-case.js",
    "require": "to-title-case.cjs"
  },
  "scripts": {
    "test": "prettier --check **/*.js && ./build.bash && npm run types && qunit test",
    "types": "tsc --allowJs --checkJs --noEmit test/ts.ts"
  },
  "prettier": {
    "semi": false,
    "singleQuote": true,
    "trailingComma": "none"
  }
}
